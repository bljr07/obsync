generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model VaultEntry {
  id        String              @id @default(uuid())
  vaultId   String
  path      String
  content   String
  hash      String
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  versions  VaultEntryVersion[] @relation("VaultEntryVersions")

  @@unique([vaultId, path])
  @@index([vaultId, path])
}

model VaultEntryVersion {
  id           String     @id @default(uuid())
  vaultEntryId String
  vaultId      String
  path         String
  content      String
  hash         String
  createdAt    DateTime   @default(now())
  vaultEntry   VaultEntry @relation("VaultEntryVersions", fields: [vaultEntryId], references: [id], onDelete: Cascade)

  @@index([vaultId, path])
}

model VaultConflict {
  id         String   @id @default(uuid())
  vaultId    String
  path       String
  baseHash   String?
  latestHash String
  createdAt  DateTime @default(now())

  @@index([vaultId, path])
}

model VaultSettings {
  vaultId       String   @id
  retentionDays Int      @default(14)
  updatedAt     DateTime @updatedAt
}

model VaultApiKey {
  id         String    @id @default(uuid())
  vaultId    String
  name       String
  role       String    @default("client")
  keyHash    String
  prefix     String
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?
  lastUsedAt DateTime?

  @@index([vaultId])
  @@index([keyHash])
}

model User {
  id                 String   @id @default(uuid())
  username           String   @unique
  passwordHash       String
  role               String   @default("admin")
  mustChangePassword Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model VaultSyncLog {
  id        String   @id @default(uuid())
  vaultId   String
  path      String?
  action    String
  message   String
  createdAt DateTime @default(now())

  @@index([vaultId, createdAt])
  @@index([vaultId, path])
}
